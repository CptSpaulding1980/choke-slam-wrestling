{% set section = page.url | cswSection %}
<a class="skip-link" href="#main-content">Zum Inhalt springen</a>
<header class="csw-masthead">
  <div class="brand-row">
    <a class="csw-brand" href="/choke-slam-wrestling/" aria-label="Choke Slam Wrestling – Startseite">
      <img class="brand-logo" src="/choke-slam-wrestling/img/csw-official-logo.jpg" alt="" width="64" height="64">
      <span>Choke Slam Wrestling<small>Private Fantasy-Liga · EST. 2018</small></span>
    </a>
    <a class="season-link" href="/choke-slam-wrestling/s08/">Die Liga. Season 8. <span aria-hidden="true">↗</span></a>
  </div>
  <div class="csw-banner{% if section.key == 'highlights' %} csw-banner-highlights{% endif %}">
    <img id="csw-banner-img" src="{{ section.banner }}" alt="" width="1536" height="200" fetchpriority="high" loading="eager">
  </div>
</header>
<nav class="csw-navigation" aria-label="Hauptnavigation">
  <div class="nav-inner">
    <button class="menu-toggle" type="button" aria-controls="csw-menu" aria-expanded="false" hidden>Menü <span aria-hidden="true">＋</span></button>
    <ul id="csw-menu" class="csw-menu">
      {% for item in csw.sections %}
      <li><a href="{{ item.href }}"{% if item.key == section.key %} aria-current="page"{% endif %}>{{ item.label }}</a></li>
      {% endfor %}
    </ul>
  </div>
</nav>