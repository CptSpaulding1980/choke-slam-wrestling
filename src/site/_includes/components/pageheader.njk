<script>
function toggleMenu() {
  var n = document.getElementById('site-nav');
  var b = document.getElementById('burger-toggle');
  n.classList.toggle('open');
  b.setAttribute('aria-expanded', n.classList.contains('open'));
  document.body.classList.toggle('menu-open', n.classList.contains('open'));
}
(function(){
  var p = window.location.pathname;
  document.querySelectorAll('.csw-main-nav ul li a').forEach(function(a){
    if(a.pathname !== '/' && p.startsWith(a.pathname)) a.classList.add('active');
  });
})();
</script>
