<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{% if title %}{{ title }}{% else %}{{ page.fileSlug }}{% endif %} — Choke Slam Wrestling</title>
  {%include "components/pageheader.njk"%}
  {% for imp in dynamics.common.head %}
    {% include imp %}
  {% endfor %}
  {% for imp in dynamics.index.head %}
    {% include imp %}
  {% endfor %}
</head>
<body>
  <main class="content">
    <header>
    {% if settings.dgShowInlineTitle === true %}
      <h1>{{ noteTitle }}</h1>
    {% endif %}
    </header>

    {% for imp in dynamics.common.beforeContent %}
      {% include imp %}
    {% endfor %}
    {% for imp in dynamics.index.beforeContent %}
      {% include imp %}
    {% endfor %}

    {{ content | hideDataview | taggify | link | safe }}

    {% for imp in dynamics.common.afterContent %}
      {% include imp %}
    {% endfor %}
    {% for imp in dynamics.index.afterContent %}
      {% include imp %}
    {% endfor %}
  </main>

  <!-- CSW Footer -->
  <footer class="csw-footer">
    <div class="faction-row">
      <span style="color:#ef4444;">🛡️ Militanter Mummenschanz</span>
      <span style="color:#22c55e;">⚔️ Saint Rebel Radicalz</span>
      <span style="color:#3b82f6;">🍸 Sweet 'n Sour Elite</span>
    </div>
    <p>© 2026 Choke Slam Wrestling — <a href="/choke-slam-wrestling/s08/">Season 8</a></p>
  </footer>

  {% for imp in dynamics.common.footer %}
    {% include imp %}
  {% endfor %}
  {% for imp in dynamics.index.footer %}
    {% include imp %}
  {% endfor %}
</body>
</html>
