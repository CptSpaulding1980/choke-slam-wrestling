---
permalink: "notes/{{ page.fileSlug | slugify }}/"
---
{% set section = page.url | cswSection %}
{% set isHome = page.url == '/home/' %}
{% set displayTitle = (title or page.fileSlug) | cswTitle(page.url) %}
<!DOCTYPE html>
<html lang="de">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="theme-color" content="#101113">
  <title>{% if isHome %}Choke Slam Wrestling – Die Liga{% else %}{{ displayTitle }} – Choke Slam Wrestling{% endif %}</title>
  <link href="/choke-slam-wrestling/styles/custom-style.css" rel="stylesheet">
  {% for imp in dynamics.common.head %}{% include imp %}{% endfor %}
  {% for imp in dynamics.notes.head %}{% include imp %}{% endfor %}
</head>
<body class="csw-site section-{{ section.key }}">
  {% include "components/pageheader.njk" %}
  <main class="content{% if isHome %} landing{% endif %}" id="main-content" tabindex="-1">
    {% if isHome %}
      {% include "components/landing.njk" %}
    {% else %}
      <nav class="breadcrumbs" aria-label="Brotkrumennavigation"><a href="/choke-slam-wrestling/">Start</a><span aria-hidden="true">/</span><a href="{{ section.href }}">{{ section.label }}</a></nav>
      <p class="eyebrow">CSW / {{ section.label }}</p>
      <article class="note-content">
        {% if '<h1' not in content %}<h1>{{ displayTitle }}</h1>{% endif %}
        {{ content | hideDataview | taggify | link | cswContent(page.url) | safe }}
      </article>
    {% endif %}
  </main>
  {% include "components/footer.njk" %}
</body>
</html>