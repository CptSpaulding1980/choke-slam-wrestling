---
permalink: "notes/{{ page.fileSlug | slugify }}/"
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{% if title %}{{ title }}{% else %}{{ page.fileSlug }}{% endif %} — Choke Slam Wrestling</title>
  {%include "components/pageheader.njk"%}
  {% for imp in dynamics.common.head %}
    {% include imp %}
  {% endfor %}
  {% for imp in dynamics.notes.head %}
    {% include imp %}
  {% endfor %}
</head>
<body>
  <main class="content">
    <header>
      {% if settings.dgShowInlineTitle === true %}
        <h1>{% if title %}{{ title }}{% else %}{{ page.fileSlug }}{% endif %}</h1>
      {% endif %}

      <!-- Breadcrumbs -->
      <nav class="breadcrumbs" aria-label="Breadcrumb">
        <a href="{{ '/choke-slam-wrestling/' | url }}">Home</a>
        {% if page.filePathStem and 'Events' in page.filePathStem %}
          » <a href="{{ '/events/' | url }}">Events</a>
        {% elif page.filePathStem and 'Wrestler' in page.filePathStem %}
          » <a href="{{ '/wrestler/' | url }}">Roster</a>
        {% elif page.filePathStem and 'Championships' in page.filePathStem %}
          » <a href="{{ '/championships/' | url }}">Titles</a>
        {% elif page.filePathStem and 'Teams' in page.filePathStem %}
          » <a href="{{ '/teams/' | url }}">Teams</a>
        {% elif page.filePathStem and 'Statistiken' in page.filePathStem %}
          » <a href="{{ '/statistiken/' | url }}">Stats</a>
        {% elif page.filePathStem and 'Referees' in page.filePathStem %}
          » <a href="{{ '/referees/' | url }}">Referees</a>
        {% endif %}
        » <span>{% if title %}{{ title }}{% else %}{{ page.fileSlug }}{% endif %}</span>
      </nav>
    </header>

    {% for imp in dynamics.common.beforeContent %}
      {% include imp %}
    {% endfor %}
    {% for imp in dynamics.notes.beforeContent %}
      {% include imp %}
    {% endfor %}

    {{ content | hideDataview | taggify | link | safe }}

    {% for imp in dynamics.common.afterContent %}
      {% include imp %}
    {% endfor %}
    {% for imp in dynamics.notes.afterContent %}
      {% include imp %}
    {% endfor %}
  </main>

  <!-- CSW Footer -->
  <footer class="csw-footer">
    <div class="faction-row">
      <span style="color:#ef4444;">🛡️ Militanter Mummenschanz</span>
      <span style="color:#22c55e;">⚔️ Saint Rebel Radicalz</span>
      <span style="color:#3b82f6;">🍸 Sweet 'n Sour Elite</span>
    </div>
    <p>© 2026 Choke Slam Wrestling — <a href="/choke-slam-wrestling/s08/">Season 8</a></p>
  </footer>

  {% for imp in dynamics.common.footer %}
    {% include imp %}
  {% endfor %}
  {% for imp in dynamics.notes.footer %}
    {% include imp %}
  {% endfor %}
</body>
</html>
